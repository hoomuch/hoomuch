{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hoomuch",
  "main": "src/index.tsx",
  "compatibility_date": "2026-11-01",

  // Run the Worker near D1 rather than near the visitor when that's faster. A page makes several
  // D1 calls; from another continent each one is a long round trip, and this makes it one. Static
  // assets are still served from the visitor's nearest location, and request.cf (the time zone
  // new accounts start with) describes the visitor either way. Requests carry a `cf-placement`
  // header saying where they ran. No effect on `wrangler dev`. See bench/README.md.
  "placement": { "mode": "smart" },

  // Tailwind and the browser bundle (public/client) are built before every dev reload and deploy.
  "build": {
    "command": "npm run build",
    "watch_dir": "src"
  },

  // Files in ./public are served directly, before the Worker runs.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hoomuch",
      // Replace with the id printed by `wrangler d1 create hoomuch` before the first deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "triggers": {
    "crons": ["*/30 * * * *"]
  },

  // Every sync runs in this queue's consumer (src/sync/consumer.ts), one connection per invocation,
  // so each gets its own request budget and time. The cron, new connections and "Sync now" send to
  // it. `wrangler deploy` creates the queue the first time if it doesn't exist yet.
  // max_concurrency 10 clears the cron's 1,000 syncs a tick within 15 minutes at up to 9 s a sync
  // (CRON_MAX_ROUNDS in src/sync/engine.ts). More slots wouldn't speed up a healthy instance, but
  // would put more syncs on D1's single writer at once, and more on providers that rate-limit per
  // IP across Cloudflare's shared egress (Paddle: 240 a minute, of which one sync may use 180).
  "queues": {
    "producers": [{ "binding": "SYNC_QUEUE", "queue": "hoomuch-sync" }],
    "consumers": [
      {
        "queue": "hoomuch-sync",
        "max_batch_size": 1,
        "max_retries": 3,
        "retry_delay": 60,
        "max_concurrency": 10
      }
    ]
  },

  "vars": {
    "APP_NAME": "hoomuch",
    "ALLOW_SIGNUP": "true",
    "SYNC_INTERVAL_MINUTES": "60",
    // Cloudflare Turnstile on log in and sign up: put the widget's site key here and set the
    // TURNSTILE_SECRET_KEY secret. Empty (the default) leaves Turnstile off.
    "TURNSTILE_SITE_KEY": "",
    // Email verification: who the sign-up confirmation mail comes from, on a domain verified in
    // Resend, e.g. "hoomuch <hello@example.com>". It's on once the RESEND_API_KEY secret is set;
    // without that secret, nothing is mailed and new accounts don't need confirming.
    "MAIL_FROM": "",
    // Public pages: "true" lets owners publish a product's verified revenue at /p/<slug>, with an
    // embeddable badge at /badge/<slug>.svg. Empty (the default) leaves them off.
    "PUBLIC_PAGES": ""
  },

  // Per-network request limits, checked before any D1 work (src/lib/rate-limit.ts). Counts are per
  // Cloudflare location and approximate; the exact limits live in D1. namespace_id only has to be
  // unique within your Cloudflare account: change it if another Worker of yours already uses it.
  "ratelimits": [
    // Every request the Worker serves (static assets never reach it).
    { "name": "RL_REQUESTS", "namespace_id": "730001", "simple": { "limit": 300, "period": 60 } },
    // Log-in and sign-up submissions: each one costs a password hash.
    { "name": "RL_AUTH", "namespace_id": "730002", "simple": { "limit": 10, "period": 60 } },
    // Provider webhook calls, per connection (exempt from RL_REQUESTS: providers share addresses).
    { "name": "RL_WEBHOOKS", "namespace_id": "730003", "simple": { "limit": 30, "period": 60 } }
  ],

  "observability": {
    "enabled": true
  }
  // Secrets (not in this file): ENCRYPTION_KEY, TURNSTILE_SECRET_KEY if you turn Turnstile on, and
  // RESEND_API_KEY if you turn email verification on. See .dev.vars.example
}
