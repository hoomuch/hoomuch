{
  "name": "hoomuch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "All your subscription revenue under one roof — Stripe, Paddle, Lemon Squeezy, Polar, RevenueCat, Chargebee, Dodo Payments, Gumroad, Adapty, Superwall.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tahabozdemir/hoomuch.git"
  },
  "homepage": "https://github.com/tahabozdemir/hoomuch#readme",
  "bugs": "https://github.com/tahabozdemir/hoomuch/issues",
  "scripts": {
    "dev": "wrangler dev",
    "predeploy": "npm run db:migrate:remote",
    "deploy": "wrangler deploy",
    "build": "npm run css && npm run js",
    "css": "tailwindcss -i ./src/styles/app.css -o ./public/app.css --minify",
    "css:watch": "tailwindcss -i ./src/styles/app.css -o ./public/app.css --watch",
    "js": "node scripts/build-client.mjs",
    "js:watch": "node scripts/build-client.mjs --watch",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "cloudflare": {
    "bindings": {
      "ENCRYPTION_KEY": {
        "description": "32 random bytes, base64. Generate one with `openssl rand -base64 32`. **Back it up:** if it's lost, every stored provider key becomes unreadable. Never rotate it in place."
      },
      "ALLOW_SIGNUP": {
        "description": "Leave `true` until you've created your own account, then set it to `false` so nobody else can sign up on your instance."
      }
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.16",
    "lucide-react": "^1.69.0",
    "motion": "^14.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
