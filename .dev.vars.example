# Copy to .dev.vars for local development. In production use:
#   wrangler secret put ENCRYPTION_KEY
#
# 32 random bytes, base64. Generate with:
#   openssl rand -base64 32
ENCRYPTION_KEY=

# Optional: Cloudflare Turnstile on log in and sign up. Set TURNSTILE_SITE_KEY in wrangler.jsonc
# (vars) and the secret here. Cloudflare's published test pair passes on any host, localhost too:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA (in a local override of vars)
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# In production: wrangler secret put TURNSTILE_SECRET_KEY
# TURNSTILE_SECRET_KEY=

# Optional: email. With a Resend API key set, sign-up mails a confirmation link and holds the new
# account at "check your inbox" until it's used, and Settings offers an email digest. Set MAIL_FROM in wrangler.jsonc
# (vars) to a sender on a domain you verified in Resend, and turn click tracking off for that
# domain so the link isn't rewritten. Locally, Resend's sandbox sender works for your own address:
#   MAIL_FROM=onboarding@resend.dev (in a local override of vars)
# In production: wrangler secret put RESEND_API_KEY
# RESEND_API_KEY=
